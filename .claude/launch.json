{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "front-end",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "front-end", "dev"],
      "port": 3000
    },
    {
      "name": "front-end-tras-proxy",
