<div
  class="cac-loader cac-loader--fullscreen"
  role="status"
  aria-live="polite"
  aria-label="Cargando…"
>
  <div class="cac-logo-spinner" aria-hidden="true">
    <span class="cac-logo-spinner__ring cac-logo-spinner__ring--outer"></span>
    <span class="cac-logo-spinner__ring cac-logo-spinner__ring--inner"></span>
    <span class="cac-logo-spinner__mark">
      <img
        src="/cac-logo.png"
        alt=""
        width="88"
        height="54"
        class="cac-logo-spinner__image"
      />
    </span>
  </div>
  <p class="cac-loader__label">Cargando…</p>
</div>
