---
import '@/styles/globals.css'

const title = 'Academy CAC · Panel administrativo'
const description =
  'Plataforma de gestión académica y administrativa de Academy CAC.'
---

<!doctype html>
<html lang="es" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#F8FAFC" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('nova_theme') ?? 'system'
        const locale = localStorage.getItem('nova_locale')
        const dark =
          saved === 'dark' ||
          (saved === 'system' &&
            window.matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', dark)
        document.documentElement.classList.toggle('light', !dark)
        document.documentElement.dataset.themePreference = saved
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light'
        document.documentElement.lang = locale === 'en' ? 'en' : 'es'
      })()
    </script>
  </head>
  <body class="bg-background font-sans antialiased">
    <slot />
  </body>
</html>
