---
import '@/styles/globals.css'

const title = 'CAC Academic · Panel administrativo'
const description =
  'Plataforma de gestión académica y administrativa de CAC Academic.'
---

<!doctype html>
<html lang="es" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#F8FAFC" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/brand/cac-logo.png" />
    <title>{title}</title>

    {/*
      Speculation Rules — estándar web, solo HTML, sin librerías.

      `eagerness: moderate` dispara al pasar el ratón por un enlace, unos 200 ms
      antes del clic, así el documento ya está en caché cuando la navegación
      ocurre de verdad.

      Se usa `prefetch` y no `prerender` a propósito. Prerenderizar ejecuta la
      página destino: aquí eso significa arrancar una segunda copia del panel,
      que volvería a pedir la sesión y los datos del tablero con las cookies del
      usuario. Se pagaría dos veces cada carga a cambio de nada.

      Y hay un límite que conviene tener claro: el panel es una SPA. `next-link`
      intercepta el clic y navega con `pushState`, así que la mayoría de las
      veces no hay navegación de documento y estas reglas no llegan a aplicarse.
      Cubren los pocos saltos reales —entrar por una URL pegada, el rebote a
      /login al cerrar sesión, un refresco—. Lo que hace instantánea la
      navegación interna es la precarga del chunk de `lib/rutas`, no esto.
    */}
    {/* El cuerpo va como JSON literal: dentro de un `is:inline` Astro no
        interpola expresiones, las copia tal cual y el navegador rechaza el
        script entero por sintaxis. */}
    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": "/api/*" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
    <script is:inline>
      (() => {
        let userEmail = ''
        try {
          const raw = localStorage.getItem('nova_user')
          if (raw) {
            const parsed = JSON.parse(raw)
            if (parsed && typeof parsed.email === 'string' && parsed.email.trim()) {
              userEmail = parsed.email.trim().toLowerCase()
            }
          }
        } catch {}

        const themeKey = userEmail ? `nova_theme_${userEmail}` : 'nova_theme'
        const localeKey = userEmail ? `nova_locale_${userEmail}` : 'nova_locale'
        const saved = localStorage.getItem(themeKey) ?? 'system'
        const locale = localStorage.getItem(localeKey) ?? localStorage.getItem('nova_locale')
        const dark =
          saved === 'dark' ||
          (saved === 'system' &&
            window.matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', dark)
        document.documentElement.classList.toggle('light', !dark)
        document.documentElement.dataset.themePreference = saved
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light'
        document.documentElement.lang = locale === 'en' ? 'en' : 'es'
      })()
    </script>
  </head>
  <body class="bg-background font-sans antialiased">
    <slot />
  </body>
</html>
