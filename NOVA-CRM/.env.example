# PostgreSQL
# Lo consume docker-compose para crear el contenedor; la app lee DB_PASSWORD,
# que docker-compose inyecta a partir de este valor.
NOVA_DB_PASSWORD=cambiar-esta-password

# Si arrancas el backend FUERA de docker (mvn spring-boot:run), define ademas
# estas variables: son las que lee la aplicacion directamente.
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=novacrm
# DB_USER=novacrm
# DB_PASSWORD=cambiar-esta-password

# MinIO
MINIO_ACCESS_KEY=cambiar-este-usuario
MINIO_SECRET_KEY=cambiar-esta-password

# JWT (obligatorio - generar con: openssl rand -base64 32)
# La aplicacion NO arranca sin este valor y rechaza los secretos de ejemplo.
JWT_SECRET=generar-con-openssl-rand-base64-32

# AWS SES (opcional en desarrollo)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@novacrm.com

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/api/v1/linkedin/callback

# ── Frontend (servidor Astro) ────────────────────────────────────────────────
# Ponlo en "true" SOLO si Astro va detras de un proxy o balanceador (Render).
# Con esto el servidor cree el X-Forwarded-For que recibe y saca de ahi la IP
# real de cada estudiante, que es lo que el backend usa para limitar por IP.
#
# Sin esto en produccion, Astro ve la IP del balanceador para todo el mundo y
# los 108 estudiantes comparten un unico contador: en cuanto cinco entran en el
# mismo minuto, al sexto le sale "Demasiados intentos".
#
# En local dejalo vacio o en "false": ahi el navegador habla directo con Astro
# y esa cabecera la escribiria el propio cliente.
TRUST_PROXY_HEADERS=false
